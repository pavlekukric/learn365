# Lokalni razvoj — kopiraj u apps/web/.env.local (git ga ignoriše). Next ga učitava sam.
# Bez ovog fajla `pnpm dev` radi kao pre Faze 8: čitanje bez naloga, napredak u pregledaču.
# Nalog se uključuje tek kad postoje SVA četiri: DATABASE_URL, APP_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.

# Baza: PGlite (Postgres u WASM-u) u folderu apps/web/.data/dev — ništa se ne instalira.
# Prazno `pglite://` znači samo u memoriji (tako rade testovi). Produkcija koristi postgres://…
DATABASE_URL=pglite://.data/dev

# Javni origin aplikacije, bez kose crte na kraju. Iz njega se izvodi Google redirect URI:
# <APP_URL>/api/auth/google/callback — isti mora biti upisan u Google OAuth klijent.
APP_URL=http://localhost:3000

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application) za localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
