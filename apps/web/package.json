{
  "name": "@learn365/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "History 365 web app — Next.js 15 App Router shell.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "screenshots": "next build && playwright test --config=playwright.screenshots.config.ts",
    "check-bundle": "node scripts/bundle-size.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@learn365/content": "workspace:*",
    "@learn365/core": "workspace:*",
    "@learn365/ui": "workspace:*",
    "@learn365/ui-web": "workspace:*",
    "drizzle-orm": "0.45.3",
    "next": "^15.1.3",
    "postgres": "3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@learn365/eslint-config": "workspace:*",
    "@learn365/tsconfig": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.17.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
