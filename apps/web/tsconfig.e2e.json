{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@learn365/tsconfig/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "playwright.screenshots.config.ts"
  ]
}
