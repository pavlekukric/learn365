# Kopija ide u /srv/learn365/.env na VPS-u (vps-install.sh je pravi ako ne postoji). Compose ga čita kroz dc.sh (--env-file).
# Nikad u repo, nikad u sliku. Vrednosti se prosleđuju kontejnerima samo kroz `environment:` u docker-compose.yml.

# Tag slike koju compose vuče; deploy.sh ga upisuje pri svakom deployu (sha-xxxxxxxxxxxx).
IMAGE_TAG=latest

# --- Faza 8: baza + Google prijava ------------------------------------------------------------
# Bez SVA četiri (DATABASE_URL, APP_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) aplikacija radi kao pre: bez naloga.
# Redosled prvog uključivanja: popuni ovaj fajl → scp novi docker-compose.yml → dc.sh up -d db → dc.sh up -d web.

# Lozinka Postgres korisnika `learn365` (servis `db`). Samo hex, da URL ispod ostane bez enkodiranja:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Ista lozinka u URL-u koji web koristi (host `db` je ime servisa u compose mreži; port nije objavljen napolje).
DATABASE_URL=postgres://learn365:<POSTGRES_PASSWORD>@db:5432/learn365
# Javni origin bez kose crte na kraju; Google redirect URI je <APP_URL>/api/auth/google/callback.
APP_URL=https://istorija365.com
# Google Cloud (sopstveni projekat, ne Računov) → Credentials → OAuth client, Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
