{
  "name": "learn365",
  "version": "0.0.0",
  "private": true,
  "description": "Learn365 — premium daily learning platform. First product: History 365 / Istorija 365.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "validate-content": "turbo run validate-content",
    "gen-content": "pnpm --filter @learn365/content gen-content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "pnpm --filter @learn365/web screenshots"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "js-yaml@4": "^4.3.2"
    }
  }
}
