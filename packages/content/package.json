{
  "name": "@learn365/content",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Course / era / section / lesson data for Learn365 products. Pure-TS; the only runtime dependency is the `server-only` marker on the `./server` entry.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./server": "./src/server.ts",
    "./loader": "./src/loader/index.ts",
    "./courses/istorija-srbije-365": "./src/courses/istorija-srbije-365/index.ts"
  },
  "dependencies": {
    "server-only": "0.0.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen-content": "tsx scripts/gen-content.ts",
    "validate-content": "tsx src/loader/validateContentFiles.ts"
  },
  "devDependencies": {
    "@learn365/eslint-config": "workspace:*",
    "@learn365/tsconfig": "workspace:*",
    "eslint": "^9.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
